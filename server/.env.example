# Duel.gold server configuration. Copy to .env and export, or set in your process manager.
# Everything has a default that works for local development. TEST NETWORKS ONLY.

# ---- network ----
PORT=8787
HOST=127.0.0.1
# Domain shown in the wallet sign-in message
PUBLIC_DOMAIN=localhost
# Comma-separated browser origins allowed to call the API / open the WebSocket. Required in production.
# ALLOWED_ORIGINS=https://duel.example
# Set true only behind a reverse proxy you control (uses X-Forwarded-For for rate limits)
TRUST_PROXY=false

# ---- chain (test networks only; the server refuses to start on any other chain id) ----
# Local:   npm run chain   →   http://127.0.0.1:8545      (chain id 31337)
# Sepolia: any Sepolia JSON-RPC URL, e.g. https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=http://127.0.0.1:8545
# Optional safety check: startup fails if the RPC reports a different chain id (Sepolia = 11155111)
# CHAIN_ID=11155111
# Blocks to wait before a deposit / withdrawal counts (Sepolia blocks are ~12 s)
CONFIRMATIONS=6
POLL_MS=4000

# ---- keys ----
# BIP-39 mnemonic: derives every player's deposit address and the treasury (hot wallet).
# Required in production. In development, if unset, one is generated into server/data/dev-mnemonic.txt.
# Whoever can read this controls all funds. Generate one with:  node -e "console.log(require('ethers').Wallet.createRandom().mnemonic.phrase)"
# HD_MNEMONIC="word word word ..."

# ---- data ----
DB_PATH=./data/duel.db

# ---- economy (amounts are integer wei) ----
FEE_BPS=1000                        # 10% of the pot
MIN_STAKE_WEI=100000000000000       # 0.0001
MAX_STAKE_WEI=50000000000000000     # 0.05
STAKE_TIERS_WEI=500000000000000,1000000000000000,2500000000000000,5000000000000000,10000000000000000
MIN_WITHDRAWAL_WEI=100000000000000  # 0.0001
MAX_WITHDRAWAL_WEI=1000000000000000000
DAILY_WITHDRAWAL_CAP_WEI=2000000000000000000

# ---- matches ----
MATCH_ACCEPT_MS=15000               # time to press Ready once paired
MATCH_COUNTDOWN_MS=3000
MATCH_GRACE_MS=15000                # extra time after a game's nominal length before results are due
QUEUE_TIMEOUT_MS=90000

# ---- operator ----
# Enables /v1/admin/* (ledger audit, on-chain solvency, flagged scores). Min 24 chars in production. Leave unset to disable.
# ADMIN_TOKEN=
LOG_LEVEL=info
