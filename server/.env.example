# Duel.gold server configuration. Copy to .env and export, or set in your process manager.
# Everything has a default that works for local development on a test chain. Settings whose default differs on mainnet are
# commented out below ON PURPOSE: leave them unset to get the right default for the network, uncomment only to override.
# REAL MONEY (Ethereum mainnet) is an explicit opt-in: see the "Mainnet" block below and README "Running on mainnet".

# ---- network ----
PORT=8787
HOST=127.0.0.1
# Domain shown in the wallet sign-in message. Must be your real host name on mainnet (not localhost).
PUBLIC_DOMAIN=localhost
# Comma-separated browser origins allowed to call the API / open the WebSocket. Required in production; on mainnet
# every entry must be an https origin and "*" is refused.
# ALLOWED_ORIGINS=https://duel.example
# Set true only behind a reverse proxy you control (Render, nginx...): it makes X-Forwarded-For the client IP for rate limits.
# On mainnet it must be set explicitly (true or false).
# TRUST_PROXY=false

# ---- chain ----
# NETWORK=mainnet is the ONE switch that allows real money. Without it the server refuses to start on a mainnet chain id (1, 8453),
# and with it the server refuses to start on anything that is not a mainnet. Leave it unset for test networks and local chains.
# NETWORK=mainnet
# Local:   npm run chain   ->   http://127.0.0.1:8545      (chain id 31337)
# Sepolia: any Sepolia JSON-RPC URL, e.g. https://ethereum-sepolia-rpc.publicnode.com
# Mainnet: your own Ethereum JSON-RPC URL (Alchemy, Infura, your node...). There is no localhost default on mainnet.
# RPC_URL=http://127.0.0.1:8545
# Chain id the RPC must report, or startup fails. Required on mainnet: 1 = Ethereum, 8453 = Base. (Sepolia = 11155111)
# CHAIN_ID=1
# Blocks to wait before a deposit / withdrawal counts. Default 6 on test/local, 12 on mainnet.
# CONFIRMATIONS=6
POLL_MS=4000
# A deposit address is swept to the treasury only when its balance is at least this many times the sweep's gas cost
# (fee data comes from the node, never a constant). Default 1 on test/local, 3 on mainnet.
# SWEEP_MIN_MULTIPLIER=3
# ...and at least this many wei, whatever gas costs (default 0.0005 ETH)
# SWEEP_MIN_WEI=500000000000000
# How often the server compares on-chain money with ledger liabilities and logs an ERROR containing "INSOLVENT" if short.
# 0 = off. Default 0 on test/local, 300000 (5 minutes) on mainnet.
# SOLVENCY_CHECK_MS=300000

# ---- keys ----
# BIP-39 mnemonic: derives every player's deposit address and the treasury (hot wallet).
# Required in production and on mainnet. In development, if unset, one is generated into server/data/dev-mnemonic.txt.
# WHOEVER CAN READ THIS CONTROLS ALL FUNDS. Never commit it, never log it. Generate one with:
#   node -e "console.log(require('ethers').Wallet.createRandom().mnemonic.phrase)"
# HD_MNEMONIC="word word word ..."

# ---- data ----
# On Render this must point at a persistent disk, or the ledger is lost on every deploy.
DB_PATH=./data/duel.db

# ---- economy (amounts are integer wei) ----
# Test/local defaults are shown. On mainnet (NETWORK=mainnet) the defaults are:
#   MIN_STAKE_WEI=1000000000000000            0.001
#   STAKE_TIERS_WEI=1000000000000000,2500000000000000,5000000000000000,10000000000000000,25000000000000000   0.001 / 0.0025 / 0.005 / 0.01 / 0.025
#   MAX_STAKE_WEI=50000000000000000           0.05
#   MIN_DEPOSIT_WEI=5000000000000000          0.005
#   MIN_WITHDRAWAL_WEI=1000000000000000       0.001
#   WITHDRAWAL_FEE_MODE=estimate
FEE_BPS=1000                        # 10% of the pot
# MIN_STAKE_WEI=100000000000000       # 0.0001
MAX_STAKE_WEI=50000000000000000     # 0.05
# STAKE_TIERS_WEI=500000000000000,1000000000000000,2500000000000000,5000000000000000,10000000000000000
# Deposits below this are recorded but not credited until the uncredited total at that address reaches it. 0 = every deposit counts.
# MIN_DEPOSIT_WEI=0
# MIN_WITHDRAWAL_WEI=100000000000000  # 0.0001
MAX_WITHDRAWAL_WEI=1000000000000000000
DAILY_WITHDRAWAL_CAP_WEI=2000000000000000000
# Network fee charged ON TOP of each withdrawal (the player receives the full amount asked for; the fee is debited as well and
# recorded in the ledger as its own entry in house:gas). "estimate" = the node's current gas price x 21000 gas + a margin;
# "fixed" = WITHDRAWAL_FEE_WEI. Default: fixed with 0 on test/local, estimate on mainnet.
# WITHDRAWAL_FEE_MODE=fixed
# WITHDRAWAL_FEE_WEI=0
# WITHDRAWAL_FEE_MARGIN_BPS=2500      # +25% over the estimate (estimate mode only)

# ---- matches ----
# Play is invite-only: players reach each other through lobby codes or links. There is no public queue or matchmaking.
MATCH_ACCEPT_MS=15000               # time to press Ready once the host starts the lobby
MATCH_COUNTDOWN_MS=3000
MATCH_GRACE_MS=15000                # extra time after a game's nominal length before results are due
LOBBY_TTL_MS=1800000                # how long an invite lobby stays open (every member's stake is refunded on expiry)
LOBBY_MAX_PLAYERS=10                # players an invite lobby holds, host included (2-10); it starts by itself when full
QUEUE_BAN_MS=300000                 # how long three no-shows in a row keep a player from hosting or joining lobbies

# ---- operator ----
# Enables /v1/admin/* (ledger audit, on-chain solvency, flagged scores). Min 24 chars in production. Leave unset to disable.
# Strongly recommended on mainnet.
# ADMIN_TOKEN=
LOG_LEVEL=info
